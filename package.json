{
  "name": "poke-equipo",
  "private": true,
  "version": "0.1.0",
  "description": "Pokémon en tu escritorio: cada uno es una sesión de Claude Code y se les habla por voz.",
  "author": "Poke Equipo",
  "packageManager": "bun@1.3.12",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:integracion": "INTEGRACION=1 vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sprites": "node scripts/bajar-sprites.mjs",
    "poderes": "node scripts/bajar-poderes.mjs",
    "dist:mac": "electron-vite build && POKE_ARCH=arm64 electron-builder --mac --arm64 --config electron-builder.config.mjs",
    "dist:mac:intel": "node scripts/preparar-intel.mjs && electron-vite build && POKE_ARCH=x64 electron-builder --mac --x64 --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "sherpa-onnx-node": "1.13.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
