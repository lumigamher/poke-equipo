{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@compartido/*": ["src/compartido/*"] }
  },
  "include": [
    "src/main",
    "src/descarga",
    "src/preload",
    "src/compartido",
    "electron.vite.config.ts",
    "vitest.config.mts"
  ]
}
